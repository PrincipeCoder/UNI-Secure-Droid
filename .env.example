# Configuración del sistema UNI-Secure-Droid

# RabbitMQ
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# Análisis Estático
ANALYSIS_TIMEOUT_SECONDS=60

# Análisis Dinámico (RNF-2, RNF-5)
DYNAMIC_TIMEOUT=90

# Emulador Android
AVD_NAME=malware_sandbox
EMULATOR_PORT=5554
ADB_PATH=adb

# Seguridad (RNF-4)
SANDBOX_NETWORK_ISOLATED=true
SANDBOX_NO_HOST_ACCESS=true

# Almacenamiento (RNF-7)
ARTIFACTS_PATH=/tmp/sandbox_artifacts/
ARTIFACTS_PERMISSIONS=0600
